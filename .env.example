# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# paper  = simulate orders on live prices (default, safe)
# broker = send real orders to the environments below
TRADING_MODE=paper

# OANDA: practice (demo money) or live (real money)
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice

# Binance: testnet (testnet.binance.vision + testnet.binancefuture.com),
# demo (demo.binance.com) or live (real money). Testnet and demo use their own keys.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_ENV=testnet
# optional: futures keys if they differ from the spot ones (the two testnets issue separate keys)
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=

# must be "yes" before any live environment is used with TRADING_MODE=broker
ALLOW_REAL_MONEY=no
